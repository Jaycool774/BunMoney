[Unit]
Description=BunMoney paper-only Python trading bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bunmoney
Group=bunmoney
WorkingDirectory=/opt/BunMoney/trading-bot
EnvironmentFile=/etc/bunmoney/bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m bunbot.service
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
StateDirectory=bunmoney-bot
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bunmoney-bot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
