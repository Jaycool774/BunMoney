# Copy outside the repository; protect permissions. Fill independent 32+ char tokens.
# These two values must also be available to the Node server.
MARKET_ENGINE_TOKEN=
BOT_SERVICE_TOKEN=
MARKET_ENGINE_URL=http://127.0.0.1:3000
BOT_PORT=8765
BOT_DB=/var/lib/bunmoney-bot/paper.sqlite3

# Public Coinbase by default. No Coinbase key; no automatic Twelve Data fallback.
BOT_DATA_PROVIDER=coinbase
